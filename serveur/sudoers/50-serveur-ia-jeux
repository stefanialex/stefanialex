# /etc/sudoers.d/50-serveur-ia-jeux
#
# Ce que lapserv peut faire en root SANS mot de passe. Tout le reste passe par
# « %sudo ALL=(ALL:ALL) ALL » du sudoers principal, donc reste possible avec le
# mot de passe, depuis un terminal ou l'interface Cockpit.
#
# Pourquoi cette liste existe : Claude Code n'a pas de terminal interactif et
# ne peut pas repondre a une invite de mot de passe. Sans dispense, il ne peut
# pas exploiter le serveur. Avec « NOPASSWD: ALL » (l'ancien
# 99-lapserv-nopasswd), n'importe quel processus tournant sous lapserv devenait
# root sans rien demander a personne. Cette liste est le juste milieu :
# l'exploitation courante est automatisable, l'installation et la destruction
# demandent un humain devant la machine.
#
# Installer :
#   sudo install -m 0440 -o root -g root <ce fichier> /etc/sudoers.d/50-serveur-ia-jeux
# Verifier AVANT de fermer le terminal :
#   sudo visudo -c
#
# ---------------------------------------------------------------------------
# Ce qui n'a PAS besoin de regle, et qu'il ne faut donc pas rajouter
# ---------------------------------------------------------------------------
# journalctl        lapserv est dans le groupe « adm » : il lit deja tout le
#                   journal sans sudo. Une regle ici serait du bruit.
# systemctl status / is-active / is-enabled / show / list-units / list-timers
#                   ne demandent aucun privilege.
# ss, lsblk, nvidia-smi, tailscale status
#                   fonctionnent deja sans root sur cette machine (verifie).
# stats-valheim.py  lit /var/lib/valheim-stats, accessible a lapserv. C'est
#                   d'ailleurs comme ca que la page Cockpit l'appelle.

# ---------------------------------------------------------------------------
# Diagnostic materiel qui, lui, exige vraiment root
# ---------------------------------------------------------------------------
Cmnd_Alias SRV_DIAG = \
    /usr/sbin/ufw status, \
    /usr/sbin/ufw status *, \
    /usr/sbin/dmidecode, \
    /usr/sbin/dmidecode *, \
    /usr/sbin/blkid, \
    /usr/sbin/blkid *, \
    /usr/sbin/smartctl -H *, \
    /usr/sbin/smartctl -i *, \
    /usr/sbin/smartctl -a *, \
    /usr/sbin/smartctl -x *, \
    /usr/sbin/smartctl --scan, \
    /usr/bin/dmesg, \
    /usr/bin/dmesg *, \
    /usr/bin/cpupower frequency-info, \
    /usr/bin/cpupower frequency-info *

# Deux precisions sur les deux dernieres entrees.
#
# dmesg exige bien root ici, « kernel.dmesg_restrict » valant 1 — il avait ete
# retire a tort le 2026-09-09 en le croyant libre d'acces. Le joker couvre
# aussi « dmesg -C », qui vide le tampon du noyau : c'est une gene pour le
# diagnostic, pas une escalade, et l'enumerer flag par flag reviendrait a
# deviner les options qu'on utilisera demain.
#
# cpupower n'est PAS installe sur cette machine : « command -v cpupower » ne
# renvoie rien, la regle ne correspond donc a rien et reste sans effet. Elle
# est gardee par avance, comme le faisait la liste precedente pour les outils
# poses plus tard par 02-drivers.sh, et parce qu'elle borne d'avance le
# sous-commande autorise : « frequency-info » en lecture, jamais
# « frequency-set », qui change la politique de frequence du processeur.
#
# La lecon du 2026-09-09, qui vaut pour toute entree ajoutee ici : un binaire
# absent et un binaire qui exige root echouent tous les deux, avec le meme
# code de retour. Verifier lequel des deux avec « command -v » avant de
# conclure.

# ---------------------------------------------------------------------------
# Bascule Valheim 1.0 : l'audit seulement
# ---------------------------------------------------------------------------
# --verifier ne modifie rien, --controle compare les buildid. La bascule reelle
# (--maj, --monde, --tout, --retour-arriere, --confirm) n'est PAS ici : elle se
# declenche toute seule via guette-valheim-1.0.timer, qui tourne en root sous
# systemd et n'a donc que faire de sudo. La lancer a la main est un acte
# delibere : qu'elle demande le mot de passe est exactement ce qu'on veut.
# Note : sudo compare la ligne de commande entiere. « --verifier --confirm »
# ne correspond a aucune entree ci-dessous, donc sera refuse.
Cmnd_Alias SRV_JOUR_J_AUDIT = \
    /usr/local/bin/jour-j-valheim.sh --verifier, \
    /usr/local/bin/jour-j-valheim.sh --controle

