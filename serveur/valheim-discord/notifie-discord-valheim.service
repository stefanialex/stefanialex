[Unit]
Description=Publication des evenements Valheim sur Discord
After=network-online.target collecte-valheim.service
Wants=network-online.target

[Service]
Type=oneshot
User=valheim
Group=valheim
StateDirectory=valheim-stats
ExecStart=/usr/local/bin/notifie-discord-valheim.py

# Le script ne fait que lire la base et parler a Discord.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
LockPersonality=yes
