[Unit]
Description=Bilan de soiree Valheim sur Discord
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=valheim
Group=valheim
StateDirectory=valheim-stats
ExecStart=/usr/local/bin/soiree-discord-valheim.py
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
