[Unit]
Description=Indice quotidien de l'oracle Valheim sur Discord
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=valheim
Group=valheim
StateDirectory=valheim-stats
ExecStart=/usr/local/bin/oracle-valheim.py --discord
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
